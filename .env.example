# Configuração de Ambiente para Demonstração e Conectividade do PocketBase
# Comente a variável para utilizar o fallback para localhost ou servidor remoto dedicado.
# PUBLIC_ENVIRONMENT força o ambiente independentemente de rodar em dev ou build estático.
# Valores suportados: 'development' | 'production'
PUBLIC_ENVIRONMENT=development

# Endpoint utilizado quando PUBLIC_ENVIRONMENT=development (ou rodando dev localmente sem PUBLIC_ENVIRONMENT)
PUBLIC_DEV_URL=http://localhost:8090

# Endpoint utilizado quando PUBLIC_ENVIRONMENT=production (ex: URL pública do túnel Cloudflare/Tailscale)
PUBLIC_PROD_URL=https://meu-tunel.trycloudflare.com

# Segredo de autenticação enviado no cabeçalho X-Proxy-Secret para o proxy reverso
# Deixe em branco durante desenvolvimento local (PocketBase em localhost)
PUBLIC_PB_PROXY_SECRET=
